// Generated from apps/wparted-gui/res/wparted.rc.in by CMake.
#include <winres.h>

1 ICON "@WPARTED_ICON@"
1 RT_MANIFEST "@WPARTED_MANIFEST@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRERELEASE
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "The WParted contributors"
            VALUE "FileDescription", "@WPARTED_FILE_DESCRIPTION@"
            VALUE "FileVersion", "@WPARTED_VERSION_STRING@"
            VALUE "InternalName", "@WPARTED_INTERNAL_NAME@"
            VALUE "LegalCopyright", "Copyright (C) 2026 The WParted contributors. GPL-2.0-or-later."
            VALUE "OriginalFilename", "@WPARTED_INTERNAL_NAME@.exe"
            VALUE "ProductName", "WParted"
            VALUE "ProductVersion", "@WPARTED_VERSION_STRING@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
