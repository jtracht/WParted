# End-to-end: generate a synthetic image, analyse it with wparted-cli, verify
# the JSON report, and verify the image was not modified (read-only guarantee).
# EMULATOR is set (e.g. to wine) when the Windows binaries are cross-compiled.
set(IMG "${WORKDIR}/cli_roundtrip.img")
execute_process(COMMAND ${EMULATOR} "${MAKE_IMAGE}" "${IMG}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "make_test_image failed: ${rc}")
endif()
file(SHA256 "${IMG}" before)
execute_process(COMMAND ${EMULATOR} "${CLI}" inspect-image "${IMG}" --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "wparted-cli exited with ${rc}: ${err}\n${out}")
endif()
string(JSON table GET "${out}" table)
string(JSON count LENGTH "${out}" partitions)
string(JSON fs0 GET "${out}" partitions 0 filesystem)
string(JSON fs2 GET "${out}" partitions 2 filesystem)
string(JSON fs3 GET "${out}" partitions 3 filesystem)
string(JSON label3 GET "${out}" partitions 3 label)
string(JSON crit0 GET "${out}" partitions 0 systemCritical)
if(NOT table STREQUAL "gpt" OR NOT count EQUAL 4 OR NOT fs0 STREQUAL "fat32" OR NOT fs2 STREQUAL "ntfs"
   OR NOT fs3 STREQUAL "ext4" OR NOT label3 STREQUAL "rootfs" OR NOT crit0)
    message(FATAL_ERROR "unexpected report: ${out}")
endif()
file(SHA256 "${IMG}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "image was modified by a read-only command")
endif()
file(REMOVE "${IMG}")

# Rescue scan: the NTFS and ext4 file systems are no longer in the table.
execute_process(COMMAND ${EMULATOR} "${MAKE_IMAGE}" "${IMG}" --lost RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "make_test_image --lost failed: ${rc}")
endif()
file(SHA256 "${IMG}" before)
execute_process(COMMAND ${EMULATOR} "${CLI}" rescue-scan-image "${IMG}" --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "rescue-scan-image exited with ${rc}: ${err}
${out}")
endif()
string(JSON count LENGTH "${out}")
string(JSON lba0 GET "${out}" 0 firstLba)
string(JSON fs0 GET "${out}" 0 filesystem)
string(JSON lba1 GET "${out}" 1 firstLba)
string(JSON fs1 GET "${out}" 1 filesystem)
string(JSON label1 GET "${out}" 1 label)
if(NOT count EQUAL 2 OR NOT lba0 EQUAL 67584 OR NOT fs0 STREQUAL "ntfs" OR NOT lba1 EQUAL 100352
   OR NOT fs1 STREQUAL "ext4" OR NOT label1 STREQUAL "rootfs")
    message(FATAL_ERROR "unexpected rescue result: ${out}")
endif()
file(SHA256 "${IMG}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "image was modified by the rescue scan")
endif()
file(REMOVE "${IMG}")

# Plan execution on an image file: dry run writes nothing, --execute applies
# and verifies, and the same plan is refused afterwards (the image changed).
execute_process(COMMAND ${EMULATOR} "${MAKE_IMAGE}" "${IMG}" --demo RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "make_test_image --demo failed: ${rc}")
endif()
set(PLAN "${WORKDIR}/cli_roundtrip_plan.json")
execute_process(COMMAND ${EMULATOR} "${IMAGE_TOOL}" plan "${IMG}" gpt-demo "${PLAN}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "image_tool plan failed: ${rc} ${err}")
endif()
file(SHA256 "${IMG}" before)
execute_process(COMMAND ${EMULATOR} "${CLI}" apply-plan "${IMG}" "${PLAN}"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
file(SHA256 "${IMG}" after)
if(NOT rc EQUAL 0 OR NOT before STREQUAL after)
    message(FATAL_ERROR "apply-plan dry run: exit ${rc}, image changed: ${out} ${err}")
endif()
execute_process(COMMAND ${EMULATOR} "${CLI}" apply-plan "${IMG}" "${PLAN}" --execute
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "apply-plan --execute failed (${rc}): ${out} ${err}")
endif()
execute_process(COMMAND ${EMULATOR} "${CLI}" inspect-image "${IMG}" --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "inspect-image after apply exited with ${rc}: ${out}")
endif()
string(JSON count LENGTH "${out}" partitions)
set(found_moved FALSE)
set(found_copy FALSE)
set(found_new FALSE)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    string(JSON first GET "${out}" partitions ${i} firstLba)
    string(JSON fs GET "${out}" partitions ${i} filesystem)
    string(JSON label GET "${out}" partitions ${i} label)
    string(JSON name GET "${out}" partitions ${i} name)
    if(first EQUAL 73728 AND fs STREQUAL "ext4" AND label STREQUAL "demo")
        set(found_moved TRUE)
    endif()
    if(first EQUAL 106496 AND fs STREQUAL "ext4" AND label STREQUAL "demo")
        set(found_copy TRUE)
    endif()
    if(first EQUAL 2048 AND name STREQUAL "wparted-new" AND fs STREQUAL "unknown")
        set(found_new TRUE)
    endif()
endforeach()
if(NOT count EQUAL 3 OR NOT found_moved OR NOT found_copy OR NOT found_new)
    message(FATAL_ERROR "unexpected layout after apply-plan: ${out}")
endif()
execute_process(COMMAND ${EMULATOR} "${CLI}" apply-plan "${IMG}" "${PLAN}" --execute
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(rc EQUAL 0)
    message(FATAL_ERROR "a plan was applied twice: ${out}")
endif()
file(REMOVE "${IMG}" "${PLAN}")

# The same kind of plan through wparted-helper.exe (ADR-0002): the helper
# validates it itself, executes only after the hash confirmation, reports back.
set(HIMG "${WORKDIR}/cli_helper.img")
set(HPLAN "${WORKDIR}/cli_helper.json")
file(REMOVE "${HIMG}" "${HIMG}.wparted-journal")
execute_process(COMMAND ${EMULATOR} "${MAKE_IMAGE}" "${HIMG}" --demo RESULT_VARIABLE rc)
execute_process(COMMAND ${EMULATOR} "${IMAGE_TOOL}" plan "${HIMG}" fat-create "${HPLAN}" RESULT_VARIABLE rc2)
if(NOT rc EQUAL 0 OR NOT rc2 EQUAL 0)
    message(FATAL_ERROR "helper test image or plan could not be made")
endif()
execute_process(COMMAND ${EMULATOR} "${CLI}" apply-plan "${HIMG}" "${HPLAN}" --execute --helper
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0 OR NOT out MATCHES "Helper validation: passed" OR NOT out MATCHES "by the helper and verified")
    message(FATAL_ERROR "apply-plan --helper failed (${rc}): ${out} ${err}")
endif()
execute_process(COMMAND ${EMULATOR} "${CLI}" inspect-image "${HIMG}" --json RESULT_VARIABLE rc OUTPUT_VARIABLE out)
if(NOT out MATCHES "\"label\": *\"WPFAT\"")
    message(FATAL_ERROR "the helper did not create the FAT32 partition: ${out}")
endif()
file(REMOVE "${HIMG}" "${HPLAN}")
message(STATUS "cli_image_roundtrip OK")
