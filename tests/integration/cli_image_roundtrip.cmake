# End-to-end: generate a synthetic image, analyse it with wparted-cli, verify
# the JSON report, and verify the image was not modified (read-only guarantee).
# EMULATOR is set (e.g. to wine) when the Windows binaries are cross-compiled.
set(IMG "${WORKDIR}/cli_roundtrip.img")
execute_process(COMMAND ${EMULATOR} "${MAKE_IMAGE}" "${IMG}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "make_test_image failed: ${rc}")
endif()
file(SHA256 "${IMG}" before)
execute_process(COMMAND ${EMULATOR} "${CLI}" inspect-image "${IMG}" --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "wparted-cli exited with ${rc}: ${err}\n${out}")
endif()
string(JSON table GET "${out}" table)
string(JSON count LENGTH "${out}" partitions)
string(JSON fs0 GET "${out}" partitions 0 filesystem)
string(JSON fs2 GET "${out}" partitions 2 filesystem)
string(JSON fs3 GET "${out}" partitions 3 filesystem)
string(JSON label3 GET "${out}" partitions 3 label)
string(JSON crit0 GET "${out}" partitions 0 systemCritical)
if(NOT table STREQUAL "gpt" OR NOT count EQUAL 4 OR NOT fs0 STREQUAL "fat32" OR NOT fs2 STREQUAL "ntfs"
   OR NOT fs3 STREQUAL "ext4" OR NOT label3 STREQUAL "rootfs" OR NOT crit0)
    message(FATAL_ERROR "unexpected report: ${out}")
endif()
file(SHA256 "${IMG}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "image was modified by a read-only command")
endif()
file(REMOVE "${IMG}")

# Rescue scan: the NTFS and ext4 file systems are no longer in the table.
execute_process(COMMAND ${EMULATOR} "${MAKE_IMAGE}" "${IMG}" --lost RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "make_test_image --lost failed: ${rc}")
endif()
file(SHA256 "${IMG}" before)
execute_process(COMMAND ${EMULATOR} "${CLI}" rescue-scan-image "${IMG}" --json
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "rescue-scan-image exited with ${rc}: ${err}
${out}")
endif()
string(JSON count LENGTH "${out}")
string(JSON lba0 GET "${out}" 0 firstLba)
string(JSON fs0 GET "${out}" 0 filesystem)
string(JSON lba1 GET "${out}" 1 firstLba)
string(JSON fs1 GET "${out}" 1 filesystem)
string(JSON label1 GET "${out}" 1 label)
if(NOT count EQUAL 2 OR NOT lba0 EQUAL 67584 OR NOT fs0 STREQUAL "ntfs" OR NOT lba1 EQUAL 100352
   OR NOT fs1 STREQUAL "ext4" OR NOT label1 STREQUAL "rootfs")
    message(FATAL_ERROR "unexpected rescue result: ${out}")
endif()
file(SHA256 "${IMG}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "image was modified by the rescue scan")
endif()
file(REMOVE "${IMG}")
message(STATUS "cli_image_roundtrip OK")
